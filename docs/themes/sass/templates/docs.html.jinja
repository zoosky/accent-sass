{# A documentation page: sidebar, prose, and previous/next.

   Both documentation sections use this template, and the sidebar shows both of
   them from either one -- a reader looking up a flag in the reference should
   see the guide beside it without going back to a menu.

   The lists are derived from the content tree rather than written here, so
   adding a page under `content/02.guide/` or `content/03.reference/` puts it
   in the navigation with no template change.

   They are built from the global `pages` and not from `page.children` or
   `page.siblings`, for two reasons found by building it the other way first in
   the theme this one derives from: `children` is empty on any page that is not
   the section index, and `siblings` excludes the page itself, so a sidebar
   built from it silently omits whichever page you are reading. `pages` is
   every menu-visible page, already ordered by `menu.order`, and filtering it
   preserves that order.

   `item.url` is used bare rather than through `url()`. Values on `pages`
   already carry the deployment path prefix; `url()` happens to be idempotent
   over them, but relying on that would be relying on an accident. #}
{% extends "base.html.jinja" %}

{% set guide_root = url("/guide") %}
{% set reference_root = url("/reference") %}
{# Containment rather than a prefix test: MiniJinja's `in` works on strings and
   there is no `startswith`. `/guide` itself does not contain `/guide/`, which
   is exactly the exclusion wanted -- each index gets its own entry below. #}
{% set guide_prefix = guide_root ~ "/" %}
{% set reference_prefix = reference_root ~ "/" %}

{% block body %}
<div class="container docs-layout">
  <nav class="docs-nav" aria-label="Documentation">
    <p class="nav-title">Usage guide</p>
    <ul>
      <li>
        <a href="{{ guide_root }}" {% if page.url == guide_root %}class="active" aria-current="page"{% endif %}>Overview</a>
      </li>
      {% for item in pages %}
      {% if guide_prefix in item.url %}
      <li>
        <a href="{{ item.url }}" {% if item.url == page.url %}class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
      </li>
      {% endif %}
      {% endfor %}
    </ul>

    <p class="nav-title">Reference</p>
    <ul>
      <li>
        <a href="{{ reference_root }}" {% if page.url == reference_root %}class="active" aria-current="page"{% endif %}>Overview</a>
      </li>
      {% for item in pages %}
      {% if reference_prefix in item.url %}
      <li>
        <a href="{{ item.url }}" {% if item.url == page.url %}class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
      </li>
      {% endif %}
      {% endfor %}
    </ul>

    <p class="nav-title">Elsewhere</p>
    <ul>
      <li><a href="{{ url('/demo/') }}">Browser demo</a></li>
      {% set changelog_url = url("/changelog") %}
      <li><a href="{{ changelog_url }}" {% if page.url == changelog_url %}class="active" aria-current="page"{% endif %}>Changelog</a></li>
      <li><a href="https://docs.rs/accent-sass">Rust API (docs.rs)</a></li>
      <li><a href="https://sass-lang.com/documentation/">Sass language</a></li>
      <li><a href="https://github.com/zoosky/accent-sass">Source</a></li>
    </ul>
  </nav>

  <article class="docs-main">
    <header>
      <h1>{{ page.title }}</h1>
      {# A page with no frontmatter, such as the mounted CHANGELOG.md, gets its
         first paragraph as its lead, which would print that paragraph twice.
         A lead the body already carries is skipped. #}
      {% if page.lead and page.lead not in page.content %}<p class="lead">{{ page.lead }}</p>{% endif %}
    </header>

    <div class="prose">
      {{ page.content | safe }}
    </div>

    {% if page.prev or page.next %}
    <nav class="page-nav" aria-label="Pagination">
      {% if page.prev %}
      <a class="prev" href="{{ page.prev.url }}">Previous<b>{{ page.prev.title }}</b></a>
      {% endif %}
      {% if page.next %}
      <a class="next" href="{{ page.next.url }}">Next<b>{{ page.next.title }}</b></a>
      {% endif %}
    </nav>
    {% endif %}
  </article>
</div>
{% endblock %}
